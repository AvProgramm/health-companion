# Laptop only. Never rename these to VITE_* variables.
USDA_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Optional public retrieval and hosted model fallback after database lookup misses.
TAVILY_API_KEY=
HF_TOKEN=
HF_MODEL=meta-llama/Llama-3.1-8B-Instruct:cheapest


# Firebase cloud diary (planned; these values do not enable uploads yet).
# Copy from Firebase Console > Project settings > General > Your apps > Web app.
# The Firebase web API key identifies the project; it is NOT a Firestore admin key.
FIREBASE_API_KEY=
FIREBASE_PROJECT_ID=
FIREBASE_AUTH_DOMAIN=
FIREBASE_APP_ID=
FIREBASE_DATABASE_ID=(default)

# Optional photo-file storage. Copy the exact bucket name from Firebase Console.
# Cloud Storage requires a Blaze billing plan; leave blank until that is wanted.
FIREBASE_STORAGE_BUCKET=

# Server authentication: use Google Application Default Credentials.
# If using a service-account JSON file, keep it OUTSIDE this repository and put
# its absolute path here. Never paste its private key into this example or Vite.
# Leave this unset when credentials come from the hosting environment or local ADC.
# GOOGLE_APPLICATION_CREDENTIALS=C:/path/outside/repo/firebase-service-account.json
